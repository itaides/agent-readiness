{
  "name": "agent-readiness",
  "version": "0.0.1",
  "description": "CLI that checks whether a website is ready for AI agents — locally, in CI, or in production.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/itaides/agent-readiness",
  "repository": {
    "type": "git",
    "url": "https://github.com/itaides/agent-readiness.git"
  },
  "bugs": "https://github.com/itaides/agent-readiness/issues",
  "keywords": [
    "ai-agents",
    "agent-readiness",
    "mcp",
    "robots-txt",
    "llms-txt",
    "well-known",
    "isitagentready",
    "cli",
    "scanner",
    "cloudflare"
  ],
  "bin": {
    "agent-readiness": "./dist/cli.js"
  },
  "files": [
    "dist",
    "prompts",
    "docs",
    "README.md",
    "LICENSE",
    "PRIVACY.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --target=node --minify --outfile=dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "audit:specs": "bun run scripts/audit-spec-staleness.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "p-limit": "^7.3.0",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.1"
  }
}
