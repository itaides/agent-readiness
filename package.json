{
  "name": "agent-readiness-cli",
  "version": "0.3.0",
  "description": "CLI that checks whether a website is ready for AI agents — locally, in CI, or in production.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/itaides/agent-readiness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itaides/agent-readiness.git"
  },
  "bugs": "https://github.com/itaides/agent-readiness/issues",
  "keywords": [
    "ai-agents",
    "agent-readiness",
    "mcp",
    "robots-txt",
    "llms-txt",
    "well-known",
    "isitagentready",
    "cli",
    "scanner",
    "cloudflare"
  ],
  "bin": {
    "agent-readiness": "dist/cli.js",
    "agent-readiness-cli": "dist/cli.js"
  },
  "exports": {
    "./library": {
      "types": "./dist/types/library.d.ts",
      "import": "./dist/library.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "prompts",
    "docs/checks.md",
    "docs/roadmap.md",
    "README.md",
    "LICENSE",
    "PRIVACY.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/cli.ts src/library.ts --target=node --minify --splitting --outdir=dist && bun run scripts/build-types.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "audit:specs": "bun run scripts/audit-spec-staleness.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "p-limit": "^7.3.0",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.1"
  }
}
