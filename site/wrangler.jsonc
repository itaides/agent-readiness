{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-readiness-site",
  "compatibility_date": "2026-10-14",
  // Runs only for pages with a Markdown version, to answer Accept: text/markdown; the hosted
  // /scan Worker lands in a follow-up. Everything else is served straight from ./dist.
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/example/"]
  }
}
