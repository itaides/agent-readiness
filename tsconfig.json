{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["bun", "node"]
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*", "site/src/**/*", "site/scripts/**/*", "site/test/**/*"],
  "exclude": ["node_modules", "dist", "testdata", "site/node_modules", "site/dist"]
}
